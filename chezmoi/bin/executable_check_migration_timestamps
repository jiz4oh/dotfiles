#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
  paths=()
  while IFS= read -r -d '' path; do
    paths+=("$path")
  done < <(git diff --cached --name-only --diff-filter=ACR -z)
  if ((${#paths[@]})); then
    set -- "${paths[@]}"
  fi
fi

invalid_migrations=$(
  for path in "$@"; do
    [[ $path =~ (^|/)db/migrate/[0-9]{14}_[^/]+\.rb$ ]] || continue

    name=${path##*/}
    timestamp=${name%%_*}

    if [[ ${timestamp: -2} == "00" ]]; then
      printf '  - %s\n' "$path"
    fi
  done
)

if [ -z "$invalid_migrations" ]; then
  exit 0
fi

cat >&2 <<EOF
拒绝提交：以下 Rails migration 的时间戳不正确：

$invalid_migrations

请生成合理、唯一且按时间排序的时间戳（分钟数应为 01-59，秒数应为 01-59），再重新暂存文件。不要把多个 migration 人工改成同一个秒数。
EOF

exit 1
