#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.os "windows" }}
exit 0
{{- end }}

if ! command -v zsh >/dev/null 2>&1; then
  echo "zsh not found, skipping oh-my-zsh install" >&2
  exit 0
fi

if [ -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  exit 0
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

# Prefer a full shallow clone. GitHub's partial-clone filter (--filter=blob:none)
# fails behind flaky proxies with "HTTP2 framing" / "unexpected eof" errors, and
# those failures used to be silently swallowed, leaving ~/.oh-my-zsh empty.
if ! git clone --depth=1 --branch master \
     https://github.com/ohmyzsh/ohmyzsh.git "$tmp_dir/oh-my-zsh"; then
  echo "failed to clone oh-my-zsh; aborting" >&2
  exit 1
fi

if [ ! -f "$tmp_dir/oh-my-zsh/oh-my-zsh.sh" ]; then
  echo "cloned oh-my-zsh is incomplete; aborting" >&2
  exit 1
fi

mkdir -p "$HOME/.oh-my-zsh"
for entry in "$tmp_dir/oh-my-zsh"/* "$tmp_dir/oh-my-zsh"/.[!.]*; do
  case "$entry" in
    "$tmp_dir/oh-my-zsh/custom") continue ;;
  esac
  cp -a "$entry" "$HOME/.oh-my-zsh/"
done

if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  echo "oh-my-zsh install verification failed" >&2
  exit 1
fi
