#!/bin/sh
set -eu

{{- $features := includeTemplate "features" . | fromJson }}
{{- if not $features.agentTools }}
exit 0
{{- end }}

if ! command -v mise >/dev/null 2>&1; then
  exit 0
fi

if ! mise which rtk >/dev/null 2>&1; then
  exit 0
fi

mise exec -- rtk init --global --opencode --auto-patch --hook-only
mise exec -- rtk init --global --codex
