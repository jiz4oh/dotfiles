#!/usr/bin/env bash
set -euo pipefail
{{- $features := includeTemplate "features" . | fromJson }}

{{- if ne .chezmoi.os "linux" }}
exit 0
{{- end }}

DISTRO_ID="{{ get .chezmoi.osRelease "id" }}"
DISTRO_LIKE="{{ get .chezmoi.osRelease "idLike" }}"

if [ -z "$DISTRO_ID" ] && [ -f /etc/os-release ]; then
  . /etc/os-release
  DISTRO_ID="${ID:-}"
  DISTRO_LIKE="${ID_LIKE:-}"
fi

case " $DISTRO_ID $DISTRO_LIKE " in
  *" debian "*|*" ubuntu "*)
    command -v apt-get >/dev/null 2>&1 || exit 0

    if [ "$(id -u)" -eq 0 ]; then
      SUDO=""
    elif command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      echo "[packages-linux][error] sudo is required to install Linux packages" >&2
      exit 1
    fi

    $SUDO apt-get update -y
    $SUDO apt-get install -y --no-install-recommends \
{{- range .packages.linux.apt.common }}
{{- if or $features.devTools (ne . "pre-commit") }}
      {{ . | quote }} \
{{- end }}
{{- end }}
{{- if $features.devTools }}
{{- range .packages.linux.apt.debian }}
      {{ . | quote }} \
{{- end }}
{{- end }}
      >/dev/null

{{- if $features.desktopApps }}

    # 1Password 官方 apt 源：桌面 app 提供 SSH agent 和 CLI 集成；
    # 官方只提供 amd64 桌面 app，arm64 只装 CLI。
    # 服务器（无 desktopApps）的 op 由 mise 安装，配合 OP_SERVICE_ACCOUNT_TOKEN 使用。
    install_1password_apt() {
      local arch pkgs keyring policy_dir debsig_dir
      arch="$(dpkg --print-architecture)"
      case "$arch" in
        amd64) pkgs="1password 1password-cli" ;;
        arm64) pkgs="1password-cli" ;;
        *)
          echo "[packages-linux][warn] unsupported arch for 1Password apt repo: $arch" >&2
          return 0
          ;;
      esac

      if ! command -v gpg >/dev/null 2>&1; then
        $SUDO apt-get install -y --no-install-recommends gnupg >/dev/null || return 1
      fi

      if [ ! -f /etc/apt/sources.list.d/1password.list ]; then
        keyring=/usr/share/keyrings/1password-archive-keyring.gpg
        policy_dir=/etc/debsig/policies/AC2D62742012EA22
        debsig_dir=/usr/share/debsig/keyrings/AC2D62742012EA22
        curl -fsSL https://downloads.1password.com/linux/keys/1password.asc \
          | $SUDO gpg --dearmor --yes --output "$keyring" || return 1
        echo "deb [arch=$arch signed-by=$keyring] https://downloads.1password.com/linux/debian/$arch stable main" \
          | $SUDO tee /etc/apt/sources.list.d/1password.list >/dev/null || return 1
        $SUDO mkdir -p "$policy_dir" "$debsig_dir" || return 1
        curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol \
          | $SUDO tee "$policy_dir/1password.pol" >/dev/null || return 1
        curl -fsSL https://downloads.1password.com/linux/keys/1password.asc \
          | $SUDO gpg --dearmor --yes --output "$debsig_dir/debsig.gpg" || return 1
        $SUDO apt-get update -y >/dev/null || return 1
      fi

      # shellcheck disable=SC2086
      $SUDO apt-get install -y --no-install-recommends $pkgs >/dev/null
    }
    install_1password_apt \
      || echo "[packages-linux][warn] failed to install 1Password, see https://support.1password.com/install-linux/" >&2
{{- end }}

{{- if $features.devTools }}
    if ! command -v ctags >/dev/null 2>&1; then
      release="2023.08.13%2Bce46d93811faefaa75b87e334d768fbf9a831861"
      case "{{ .chezmoi.arch }}" in
        arm64|aarch64) file="uctags-2023.08.13-linux-arm64" ;;
        amd64|x86_64) file="uctags-2023.08.13-linux-x86_64" ;;
        *)
          echo "[packages-linux][warn] unsupported arch for prebuilt ctags: {{ .chezmoi.arch }}" >&2
          exit 0
          ;;
      esac
      tmp_dir="$(mktemp -d)"
      trap 'rm -rf "$tmp_dir"' EXIT
      curl -fsSL "https://github.com/universal-ctags/ctags-nightly-build/releases/download/$release/$file.tar.xz" -o "$tmp_dir/ctags.tar.xz"
      tar -C "$tmp_dir" -xf "$tmp_dir/ctags.tar.xz"
      $SUDO install -m 0755 "$tmp_dir/$file/bin/ctags" /usr/local/bin/ctags
    fi
{{- end }}
    ;;
  *" arch "*|*" omarchy "*)
    command -v pacman >/dev/null 2>&1 || exit 0

    if [ "$(id -u)" -eq 0 ]; then
      SUDO=""
    elif command -v sudo >/dev/null 2>&1; then
      SUDO="sudo"
    else
      echo "[packages-linux][error] sudo is required to install Linux packages" >&2
      exit 1
    fi

    $SUDO pacman -S --needed --noconfirm \
{{- range .packages.linux.arch }}
{{- if or $features.devTools (not (has . (list "pre-commit" "ctags"))) }}
      {{ . | quote }} \
{{- end }}
{{- end }}

{{- if $features.desktopApps }}

    # 1Password：Omarchy 自带 1password-beta / 1password-cli；
    # 纯 Arch 官方仓库没有，只提示去 AUR 安装，不在这里引入 AUR helper。
    for pkg in 1password-cli 1password; do
      if [ "$pkg" = "1password" ] && pacman -Q 1password-beta >/dev/null 2>&1; then
        continue
      fi
      pacman -Q "$pkg" >/dev/null 2>&1 && continue
      if pacman -Si "$pkg" >/dev/null 2>&1; then
        $SUDO pacman -S --needed --noconfirm "$pkg" \
          || echo "[packages-linux][warn] failed to install $pkg" >&2
      else
        echo "[packages-linux][warn] $pkg not in pacman repos, install it from AUR: https://aur.archlinux.org/packages/$pkg" >&2
      fi
    done
{{- end }}
    ;;
  *)
    exit 0
    ;;
esac
