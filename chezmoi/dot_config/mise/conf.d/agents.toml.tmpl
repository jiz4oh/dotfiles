{{- $features := includeTemplate "features" . | fromJson }}
[tools]
"npm:skills" = "latest"
codex = "latest"
"github:rtk-ai/rtk" = "latest"
{{- if and $features.desktopApps (eq .chezmoi.os "darwin") }}

[tools."github:getpaseo/paseo"]
version = "latest"
asset_pattern = "Paseo-{{ "{{ version }}" }}-{{ if eq .chezmoi.arch "amd64" }}x64{{ else }}{{ .chezmoi.arch }}{{ end }}.zip"
strip_components = 0
postinstall = 'mkdir -p "$HOME/Applications" && ln -sfn "$MISE_TOOL_INSTALL_PATH/Paseo.app" "$HOME/Applications/Paseo.app"'
{{- else }}
"github:getpaseo/paseo" = "latest"
{{- end }}

[tools.opencode]
version = "latest"
# 升级后让 process-compose 托管的 opencode server 切到新版本；服务未运行时静默跳过。
postinstall = '"$HOME/bin/pcctl" process restart opencode >/dev/null 2>&1 || true'

[settings]
minimum_release_age_excludes = ["codex"]
