# https://mise.jdx.dev/configuration.html
{{- $features := includeTemplate "features" . | fromJson }}
{{- $isOmarchy := and (eq .chezmoi.os "linux") (eq (get .chezmoi.osRelease "id") "omarchy") }}
[tools]
# https://github.com/jdx/mise/blob/main/registry.toml
{{- if $isOmarchy }}
# Provided by pacman on Omarchy: bat, fd, neovim, ripgrep, usage.
{{- else }}
bat = "latest"
"github:sharkdp/fd" = "latest"
neovim = "latest"
rg = "latest"
usage = "latest"
{{- end }}

"github:bootandy/dust" = "latest"
zoxide = "latest"
{{- if $features.devTools }}
shellcheck = "latest"
{{- end }}
# tirith = "latest"
{{- if $features.desktopApps }}
"github:lemonade-command/lemonade" = "latest"
{{- end }}
{{- if and $isOmarchy $features.agentTools }}
# Omarchy's lazy launcher registers Codex in the global mise config.
codex = "latest"
{{- end }}
{{- if and $features.desktopApps (eq .chezmoi.os "darwin") }}
"github:cormiertyshawn895/PixelPerfect" = { version = "latest", no_app = "false" }
{{- end }}

[settings]
go_set_gobin = true
status.missing_tools = "never"
