{{- /* chezmoi:modify-template */ -}}

{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" -}}
  {{- $current = fromJson .chezmoi.stdin -}}
{{- end -}}

{{- $managed := .opencode.managed -}}

{{- /* Expand "~/" in instructions: opencode is not guaranteed to expand it. */ -}}
{{- if hasKey $managed "instructions" -}}
  {{- $paths := list -}}
  {{- range $managed.instructions -}}
    {{- $paths = append $paths (regexReplaceAll "^~/" . (printf "%s/" $.chezmoi.homeDir)) -}}
  {{- end -}}
  {{- $managed = set (deepCopy $managed) "instructions" $paths -}}
{{- end -}}

{{- /* Deep merge; arrays = managed ∪ local-only (see .chezmoitemplates/opencode-merge.json). */ -}}
{{- $merged := includeTemplate "opencode-merge.json" (dict "cur" $current "man" $managed) | fromJson -}}

{{ $merged | toPrettyJson }}
