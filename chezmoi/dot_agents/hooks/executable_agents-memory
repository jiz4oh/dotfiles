#!/usr/bin/env python3

import json
import sys


REMINDER = (
    "Before finishing meaningful engineering work, use $agents-memory to "
    "preserve only durable, evidence-backed project knowledge. Update the "
    "nearest repository memory only when something qualifies; preserve "
    "unrelated work."
)


def main():
    try:
        event = json.load(sys.stdin).get("hook_event_name", "")
    except (AttributeError, json.JSONDecodeError):
        event = ""

    output = {
        "hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": REMINDER,
        },
        "suppressOutput": True,
    }
    json.dump(output, sys.stdout, separators=(",", ":"))


if __name__ == "__main__":
    main()
