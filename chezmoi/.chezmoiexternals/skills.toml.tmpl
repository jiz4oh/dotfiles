{{- if eq .chezmoi.os "darwin" }}
[".agents/skill-sources/ponytail"]
  type = "git-repo"
  url = "https://github.com/dietrichgebert/ponytail"
  refreshPeriod = "72h"
  clone.args = ["--filter=blob:none"]
  pull.args = ["--ff-only"]
  x.skills = ["*=skills"]

[".agents/skill-sources/show-me"]
  type = "git-repo"
  url = "https://github.com/humanlayer/skills"
  refreshPeriod = "72h"
  clone.args = ["--filter=blob:none"]
  pull.args = ["--ff-only"]
  x.skills = ["show-me=plugins/show-me"]

[".agents/skill-sources/ordinary-claude-skills"]
