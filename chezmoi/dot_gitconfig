[user]
	name = jiz4oh
	email = git@jiz4oh.com
	# 用 1Password 里的 github (ED25519) 钥匙做 SSH 签名，经 SSH agent 取私钥
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICg3HbfyXci8Ff6EL1CGfGR2r/tsEdJkK9/zzd2GMNEm
[credential]
	helper = osxkeychain
  helper = store
  helper = cache --timeout 86400
[core]
	editor = ${EDITOR:-vim}
	excludesfile = ~/.gitignore
  autocrlf = input
[init]
	templatedir = ~/.git_template
[alias]
	ctags = !.git/hooks/ctags
  # 删除最近一个提交，保留文件修改
  undo = reset --soft HEAD^
  # 删除最近一个提交，不保留文件
  cancel = reset --hard HEAD^
  # 提交完了，发现还需要一点小修改，不想新建一个提交
  onemore = commit -a --amend --no-edit
[pull]
	autostash = true
[push]
	default = upstream
  autoSetupRemote = true
	followTags = true
[rebase]
	autosquash = true
[gpg]
	format = ssh
[gpg "ssh"]
	# 本地验证签名（git log --show-signature）用
	allowedSignersFile = ~/.config/git/allowed_signers
[include]
	path = .gitconfig.local
[github]
	user = jiz4oh
[log]
	date = iso-local
[status]
  # Display submodule rev change summaries in status
  submoduleSummary = true
[color "branch"]
  # Blue on black is hard to read in git branch -vv: use cyan instead
  upstream = cyan
[tag]
  gpgSign = true
  # Sort tags as version numbers whenever applicable, so 1.10.2 is AFTER 1.2.0.
  sort = version:refname
[versionsort]
  prereleaseSuffix = -pre
  prereleaseSuffix = .pre
  prereleaseSuffix = -beta
  prereleaseSuffix = .beta
  prereleaseSuffix = -rc
  prereleaseSuffix = .rc
[merge]
	conflictstyle = merge
[commit]
	verbose = true
	gpgsign = true
[diff]
	algorithm = histogram
	tool = nvim_difftool
[branch]
	sort = -committerdate
[fetch]
	prune = true

[url "git@github.com:"]
  pushInsteadOf = "https://github.com/"

[difftool "nvim_difftool"]
  cmd = nvim -c \"CodeDiff\"
